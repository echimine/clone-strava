{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths --copy-files --ignore \"**/*.spec.ts\"",
    "check-types": "tsc --noEmit",
    "dev": "swc src -d dist --strip-leading-paths --ignore \"**/*.spec.ts\" -w & node --watch --env-file-if-exists=.env dist/main.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "openapi:export": "node --env-file-if-exists=.env dist/openapi/export.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@repo/contracts": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/realtime": "workspace:*",
    "better-auth": "1.7.6",
    "bullmq": "6.3.8",
    "express": "5.2.1",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "nestjs-pino": "5.2.0",
    "nestjs-zod": "5.5.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@repo/typescript-config": "workspace:*",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.2",
    "chokidar": "5.0.0",
    "drizzle-orm": "0.45.3",
    "pino-pretty": "13.1.3",
    "standardwebhooks": "1.1.1",
    "typescript": "7.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.1"
  }
}
