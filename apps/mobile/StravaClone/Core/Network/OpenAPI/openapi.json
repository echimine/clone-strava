  "info": {
    "title": "Clone Strava API",
    "description": "REST API for the mobile app and the backoffice (ADR-009).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FeedResponseDto_Output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "title": {
                  "type": "string"
                },
                "sportTypeCode": {
                  "type": "string",
                  "minLength": 1
                },
                "startedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "visibility": {
                  "type": "string",
                  "enum": [
                    "public",
                    "followers",
                    "private"
                  ]
                },
                "locationName": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stats": {
                  "type": "object",
                  "properties": {
                    "distanceM": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "movingTimeS": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "elapsedTimeS": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "elevationGainM": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "distanceM",
                    "movingTimeS",
                    "elapsedTimeS",
                    "elevationGainM"
                  ],
                  "additionalProperties": false
                },
                "map": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "polyline": {
                      "type": "string",
                      "minLength": 1
                    },
                    "precision": {
                      "type": "number",
                      "const": 5
                    }
                  },
                  "required": [
                    "polyline",
                    "precision"
                  ],
                  "additionalProperties": false
                },
                "author": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "displayName": {
                      "type": "string"
                    },
                    "avatarUrl": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "displayName",
                    "avatarUrl"
                  ],
                  "additionalProperties": false
                },
                "engagement": {
                  "type": "object",
                  "properties": {
                    "kudosCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "commentCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "viewerHasKudoed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "kudosCount",
                    "commentCount",
                    "viewerHasKudoed"
                  ],
                  "additionalProperties": false
                },
                "viewerIsAuthor": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "title",
                "sportTypeCode",
                "startedAt",
                "visibility",
                "locationName",
                "stats",
                "map",
                "author",
                "engagement",
                "viewerIsAuthor"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "CreateActivityRequestDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sportTypeCode": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "followers",
              "private"
            ]
          },
          "isManual": {
            "type": "boolean"
          },
          "distanceM": {
            "type": "number",
            "minimum": 0
          },
          "movingTimeS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "elapsedTimeS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "elevationGainM": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "sportTypeCode",
          "title",
          "startedAt",
          "endedAt",
          "visibility",
          "isManual"
        ]
      },
      "CreateActivityImportRequestDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "format": {
            "type": "string",
            "enum": [
              "gpx",
              "tcx",
              "fit"
            ]
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "sizeBytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 26214400
          },
          "sportTypeCode": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "followers",
              "private"
            ]
          }
        },
        "required": [
          "id",
          "format",
          "fileName",
          "sizeBytes"
        ]
      },
      "KudosResponseDto_Output": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "kudosCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "viewerHasKudoed": {
            "type": "boolean"
          }
        },
        "required": [
          "activityId",
          "kudosCount",
          "viewerHasKudoed"
        ],
        "additionalProperties": false
      },
      "RevenueCatWebhookBodyDto": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string"
          },
          "event": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "app_user_id": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "app_user_id"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "event"
        ]
      },
      "ResendWebhookBodyDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "email_id": {
                "type": "string"
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
