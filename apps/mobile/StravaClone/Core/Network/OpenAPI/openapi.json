  "info": {
    "title": "Clone Strava API",
    "description": "REST API for the mobile app and the backoffice (ADR-009).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateActivityRequestDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sportTypeCode": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "followers",
              "private"
            ]
          },
          "isManual": {
            "type": "boolean"
          },
          "distanceM": {
            "type": "number",
            "minimum": 0
          },
          "movingTimeS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "elapsedTimeS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "elevationGainM": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "sportTypeCode",
          "title",
          "startedAt",
          "endedAt",
          "visibility",
          "isManual"
        ]
      },
      "RevenueCatWebhookBodyDto": {
        "type": "object",
        "properties": {
          "api_version": {
            "type": "string"
          },
          "event": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "app_user_id": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "type",
              "app_user_id"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "event"
        ]
      },
      "ResendWebhookBodyDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "email_id": {
                "type": "string"
              },
              "to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "type",
          "data"
        ]
      }
    }
  }
}
