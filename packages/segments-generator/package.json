    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/geo": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
