    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.217.0",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
