# Modèle de .env de PROD — à copier sur le VPS en
# /opt/www/strava.echimine.fr/prod/.env (renommer le fichier depuis env.prod.template),
# valeurs réelles → Apple Mots de passe. `chmod 600` obligatoire, jamais commité avec de
# vraies valeurs, jamais déposé tel quel sur le VPS sous ce nom.
#
# Ce fichier liste les CLÉS attendues par docker-compose.yml (déclarées via env_file sur
# chaque service). Toutes les apps ne consomment pas toutes les clés : chaque conteneur ne
# lit que ce dont il a besoin, mais un seul .env partagé simplifie l'opération sur ce VPS
# mono-stack (cf. schémas Zod : packages/contracts/src/config/env.ts).

# ---- Postgres (db) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- Redis (redis + api + realtime + worker) ----
# Doit être IDENTIQUE au `requirepass` défini dans redis.conf (déposé à côté de ce .env).
REDIS_PASSWORD=
# Host = redis (réseau data). Mot de passe URL-encodé si caractères spéciaux.
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# ---- api ----
# Host = db (réseau data), mot de passe URL-encodé si caractères spéciaux.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
LOG_LEVEL=info
# >= 32 caractères (better-auth échoue au boot sinon), openssl rand -hex 32.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.strava.echimine.fr
# Secret HMAC des tokens realtime, partagé entre api et realtime (ADR-010/ADR-021).
REALTIME_TOKEN_SECRET=
# OVH Object Storage (bucket assets DÉDIÉ à l'app, jamais le user/bucket du script de backup,
# cf. ADR 0002-backups-buckets-separes).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optionnels (posthog-node) : l'app démarre sans, mais l'analytics est désactivé si absent.
POSTHOG_API_KEY=
POSTHOG_HOST=
REVENUECAT_WEBHOOK_SECRET=

# ---- worker ----
# DATABASE_URL, REDIS_URL, LOG_LEVEL, S3_*, POSTHOG_* déjà déclarés ci-dessus (partagés).
REVENUECAT_API_KEY=
# Optionnel (ADR-029) : token Mapbox dédié au worker (scopes publics, sans restriction d'URL)
# pour le nom du lieu des activités. Absent = pas de nom de lieu. Ne JAMAIS laisser vide
# (`MAPBOX_GEOCODING_TOKEN=` fait échouer la validation) : supprimer la ligne si non utilisé.
MAPBOX_GEOCODING_TOKEN=
# Endpoint temporaire (gratuit, 100k req/mois) par défaut ; `true` = endpoint permanent payant.
# MAPBOX_GEOCODING_PERMANENT=true

# ---- realtime ----
# REDIS_URL, LOG_LEVEL, REALTIME_TOKEN_SECRET déjà déclarés ci-dessus (partagés).

# ---- admin ----
# API_INTERNAL_URL est fixé en dur dans docker-compose.yml (http://api:3001, réseau
# admin-api) : ne pas le dupliquer ici. NEXT_PUBLIC_MAPBOX_TOKEN est un BUILD-ARG (secret
# GitHub), inliné à l'image au build : il n'a pas sa place dans ce .env runtime.
# Ajouter ici toute future variable serveur (non NEXT_PUBLIC_*) que l'admin consommerait
# au runtime (aucune identifiée à ce jour).

# ---- Discord (notifications de déploiement, deploy.sh) ----
# Pas une variable d'env : l'URL du webhook Discord vit dans un fichier séparé
# .discord-webhook-url (chmod 600), lu directement par deploy.sh — voir deploy/deploy.sh.
