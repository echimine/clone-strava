# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store

# Env files (secrets) - les .env.example restent versionnés (ADR-018)
.env*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
*.tsbuildinfo


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Misc
.DS_Store
*.pem

# Editors
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# iOS / Xcode (apps/mobile)
xcuserdata/
*.xcuserstate
DerivedData/
.build/
.swiftpm/
*.ipa
*.dSYM.zip
*.dSYM
# Generated by XcodeGen from apps/mobile/project.yml (source of truth)
apps/mobile/*.xcodeproj/*
# ...except Package.resolved, to pin SPM versions (reproducible builds)
!apps/mobile/StravaClone.xcodeproj/project.xcworkspace/
apps/mobile/StravaClone.xcodeproj/project.xcworkspace/*
!apps/mobile/StravaClone.xcodeproj/project.xcworkspace/xcshareddata/
apps/mobile/StravaClone.xcodeproj/project.xcworkspace/xcshareddata/*
!apps/mobile/StravaClone.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
apps/mobile/StravaClone.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!apps/mobile/StravaClone.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
apps/mobile/StravaClone/Info.plist
# Secrets iOS (jeton Mapbox, clés RevenueCat / PostHog) : xcconfig non versionné (ADR-002)
Secrets.xcconfig
Secrets.xcconfig.bak

# Claude Code / ruflo
.claude
.claude-flow
.swarm
.hive-mind
ruvector.db
